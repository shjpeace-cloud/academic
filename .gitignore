# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Local server / build artefacts
.cache/
node_modules/

# Claude Code local-only settings (per-machine permissions)
.claude/settings.local.json

# Personal career consulting data — must NOT be in public repo.
# Move to a separate PRIVATE repo. Local files retained for migration.
.claude/career/

# Daily Claude Code worklog — kept local only (consistent with timesheet repo).
.claude/worklog/

# Time-stats integration: place timesheet JSON backups here for local-only
# integrated analysis (scenario A). Not pushed to public repo.
.timesheet-stats/

# Co-authors' GPRNK master workbooks. The public release is built from these
# into data/gprnk/ by .claude/gprnk-workspace/build_gprnk.py; the master itself
# carries third-party series (GPR country indices, EPU, KOSPI/VKOSPI, FX) that
# are not ours to redistribute.
.claude/*.xlsx

# Working papers / manuscripts dropped here for Claude to read.
# Unpublished drafts must never reach this public repo.
.claude/papers/

# Root-level manuscripts / scratch files — never publish from this repo.
# (Site PDFs live in data/, which stays tracked.)
/*.pdf
/*.docx
/*.doc
/*.hwp
/*.hwpx
/scratch_*.txt
